#!/bin/bash
#SBATCH -J MUW-CI
#SBATCH -p cpu
#SBATCH --cpus-per-task=124
#SBATCH --mem=496G
#SBATCH --time=72:00:00
#SBATCH --mail-type="END,FAIL"
#SBATCH --mail-user=louise.jespersen@meduniwien.ac.at
#SBATCH --output="slurm-%j.out"

# Sanity check that the script was submitted via sbatch
if [ -z "$SLURM_JOB_ID" ]; then
    echo "This script must be submitted via sbatch."
    exit 1
fi

# srun -D MA --container-image=nvcr.io/muwsc/medstat/r-base:INVENTS  bash start_process.sh
for i in {1..15}; do
  srun --export=scenario=A1,row=$i --container-image=nvcr.io/muwsc/medstat/r-base:CIRCTSIM  bash -c "cd CI.RCT.Sim/; ./run_one_vaccine_sim.sh"
done

for i in {1..10}; do
  srun --export=scenario=A2,row=$i --container-image=nvcr.io/muwsc/medstat/r-base:CIRCTSIM  bash -c "cd CI.RCT.Sim/; ./run_one_vaccine_sim.sh"
done

for i in {1..20}; do
  srun --export=scenario=B1,row=$i --container-image=nvcr.io/muwsc/medstat/r-base:CIRCTSIM  bash -c "cd CI.RCT.Sim/; ./run_one_vaccine_sim.sh"
done

for i in {1..30}; do
  srun --export=scenario=C1,row=$i --container-image=nvcr.io/muwsc/medstat/r-base:CIRCTSIM  bash -c "cd CI.RCT.Sim/; ./run_one_vaccine_sim.sh"
done

for i in {1..40}; do
  srun --export=scenario=D1,row=$i --container-image=nvcr.io/muwsc/medstat/r-base:CIRCTSIM  bash -c "cd CI.RCT.Sim/; ./run_one_vaccine_sim.sh"
done

for i in {1..45}; do
  srun --export=scenario=extra,row=$i --container-image=nvcr.io/muwsc/medstat/r-base:CIRCTSIM  bash -c "cd CI.RCT.Sim/; ./run_one_vaccine_sim.sh"
done
