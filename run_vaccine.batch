#!/bin/bash
#SBATCH -J MUW-CI
#SBATCH -p cpu
#SBATCH --cpus-per-task=124
#SBATCH --mem=496G
#SBATCH --time=72:00:00
#SBATCH --mail-type="END,FAIL"
#SBATCH --mail-user=louise.jespersen@meduniwien.ac.at
#SBATCH --output="slurm-%j.out"

# Sanity check that the script was submitted via sbatch
if [ -z "$SLURM_JOB_ID" ]; then
    echo "This script must be submitted via sbatch."
    exit 1
fi

# srun -D MA --container-image=nvcr.io/muwsc/medstat/r-base:INVENTS  bash start_process.sh
srun --container-image=nvcr.io/muwsc/medstat/r-base:CIRCTSIM  bash -c "cd CI.RCT.Sim/; ./run_all_vaccine_sims.sh"

# Paste this job script into a text file, and submit with the command: 
# sbatch <filename>.sh

